# Copy to .env.local and fill in. Values that start with EXPO_PUBLIC_ are
# bundled into the app, so never put a secret in one.

# A mainnet RPC endpoint. .skr names and SKR balances are read from mainnet.
# The public endpoint is rate limited. If you use a keyed endpoint, remember the
# key ships inside the APK: use one with tight rate limits, or put a proxy in front.
EXPO_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
