{
  "name": "penny-post",
  "displayName": "Penny Post",
  "description": "A letterbox for every .skr name. The post comes once a day, and postage goes to the reader.",
  "keywords": [
    "solana-mobile",
    "mobile-wallet-adapter",
    "seeker",
    "skr",
    "anchor",
    "expo",
    "react-native"
  ],
  "main": "./index.js",
  "version": "0.1.0",
  "scripts": {
    "anchor": "cd anchor && anchor",
    "anchor:build": "cd anchor && anchor build",
    "anchor:deploy:devnet": "cd anchor && anchor build && anchor program deploy --provider.cluster devnet",
    "anchor:deploy:localnet": "cd anchor && anchor build && anchor program deploy --provider.cluster localnet",
    "anchor:localnet": "cd anchor && anchor localnet",
    "anchor:setup": "cd anchor && anchor keys sync && anchor build && cd .. && npm run codama:js",
    "anchor:test": "cd anchor && anchor test",
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "codama:js": "codama run js -c ./anchor/codama.mjs",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "web": "expo start --web",
    "test": "vitest run src",
    "anchor:unit": "cd anchor && cargo test -p penny_post --lib",
    "post-office": "tsx scripts/post-office.ts",
    "android:apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "@expo-google-fonts/besley": "^0.4.1",
    "@expo-google-fonts/kalam": "^0.4.1",
    "@expo-google-fonts/mukta": "^0.4.1",
    "@expo/metro-runtime": "~57.0.5",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "expo": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "^57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "~19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.5.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.4",
    "tailwindcss": "~4.1.16",
    "tweetnacl": "^1.0.3",
    "uniwind": "~1.0.0"
  },
  "devDependencies": {
    "@codama/cli": "^1.6.0",
    "@codama/nodes-from-anchor": "^1.5.3",
    "@codama/renderers-js": "^2.3.1",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "react-native-reanimated": "4.5.4",
    "react-native-worklets": "0.10.4"
  },
  "resolutions": {
    "react-native-reanimated": "4.5.4",
    "react-native-worklets": "0.10.4"
  },
  "private": true
}
